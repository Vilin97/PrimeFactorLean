    let Az : N3 := ⟨b0 ^^^ ((b0 ^^^ d0) &&& sel), b1 ^^^ ((b1 ^^^ d1) &&& sel), b2 ^^^ ((b2 ^^^ d2) &&& sel)⟩
    let s := N3.sqr m (N3.add m Ax Az)
    let e := N3.sqr m (N3.sub m Ax Az)
    let t := N3.sub m s e
    let Dx := N3.mul m s e
    let Dz := N3.mul m t (N3.add m e (N3.mul m a24 t))
    let u := N3.mul m (N3.sub m X1 Z1) (N3.add m X0 Z0)
    let v := N3.mul m (N3.add m X1 Z1) (N3.sub m X0 Z0)
    let Sx := N3.sqr m (N3.add m u v)
    let Sz := N3.mul m xP (N3.sqr m (N3.sub m u v))
    N3.ladderGo m a24 xP bits i
      (Dx.l0 ^^^ ((Dx.l0 ^^^ Sx.l0) &&& sel)) (Dx.l1 ^^^ ((Dx.l1 ^^^ Sx.l1) &&& sel)) (Dx.l2 ^^^ ((Dx.l2 ^^^ Sx.l2) &&& sel))
      (Dz.l0 ^^^ ((Dz.l0 ^^^ Sz.l0) &&& sel)) (Dz.l1 ^^^ ((Dz.l1 ^^^ Sz.l1) &&& sel)) (Dz.l2 ^^^ ((Dz.l2 ^^^ Sz.l2) &&& sel))
      (Sx.l0 ^^^ ((Sx.l0 ^^^ Dx.l0) &&& sel)) (Sx.l1 ^^^ ((Sx.l1 ^^^ Dx.l1) &&& sel)) (Sx.l2 ^^^ ((Sx.l2 ^^^ Dx.l2) &&& sel))
      (Sz.l0 ^^^ ((Sz.l0 ^^^ Dz.l0) &&& sel)) (Sz.l1 ^^^ ((Sz.l1 ^^^ Dz.l1) &&& sel)) (Sz.l2 ^^^ ((Sz.l2 ^^^ Dz.l2) &&& sel))

instance : Arith N3 Mod3 where
  mul := N3.mul
  sqr := N3.sqr
  add := N3.add
  sub := N3.sub
  modulus := Mod3.n
  ofLimbs _ x := N3.ofLimbs x
  limbNat := N3.limbNat
  isZero := N3.isZero
  limbs := 3
  ladder m a24 xP bits i X0 Z0 X1 Z1 := N3.ladderGo m a24 xP bits i
    X0.l0 X0.l1 X0.l2 Z0.l0 Z0.l1 Z0.l2
    X1.l0 X1.l1 X1.l2 Z1.l0 Z1.l1 Z1.l2

/-- A residue modulo a `Mod4` in Montgomery form: 4 limbs of 28 bits. -/
structure N4 where
  l0 : UInt64
  l1 : UInt64
  l2 : UInt64
  l3 : UInt64
  deriving Inhabited

/-- An odd modulus below `2^112` with its limbs and `-n⁻¹ mod 2^28`. -/
structure Mod4 where
  n : Nat
  n0 : UInt64
  n1 : UInt64
  n2 : UInt64
  n3 : UInt64
  ninv : UInt64

def Mod4.ofNat (n : Nat) : Mod4 :=
  ⟨n, (n >>> 0 &&& 0xFFFFFFF).toUInt64, (n >>> 28 &&& 0xFFFFFFF).toUInt64, (n >>> 56 &&& 0xFFFFFFF).toUInt64, (n >>> 84 &&& 0xFFFFFFF).toUInt64, negInv28 (n &&& 0xFFFFFFF).toUInt64⟩

@[inline] def N4.ofLimbs (x : Nat) : N4 :=
  ⟨(x >>> 0 &&& 0xFFFFFFF).toUInt64, (x >>> 28 &&& 0xFFFFFFF).toUInt64, (x >>> 56 &&& 0xFFFFFFF).toUInt64, (x >>> 84 &&& 0xFFFFFFF).toUInt64⟩

@[inline] def N4.limbNat (a : N4) : Nat :=
  (a.l0.toNat <<< 0) ||| (a.l1.toNat <<< 28) ||| (a.l2.toNat <<< 56) ||| (a.l3.toNat <<< 84)

@[inline] def N4.isZero (a : N4) : Bool :=
  (a.l0 ||| a.l1 ||| a.l2 ||| a.l3) == 0

/-- Montgomery product `a b R⁻¹ mod n` (`R = 2^112`), inputs and output in `[0, n)`. -/
@[inline] def N4.mul (m : Mod4) (a b : N4) : N4 :=
  let msk : UInt64 := 0xFFFFFFF
  let acc : UInt64 := 0
  let acc := acc + a.l0 * b.l0
  let q0 := ((acc &&& msk) * m.ninv) &&& msk
  let acc := (acc + q0 * m.n0) >>> 28
  let acc := acc + a.l0 * b.l1 + a.l1 * b.l0 + q0 * m.n1
  let q1 := ((acc &&& msk) * m.ninv) &&& msk
  let acc := (acc + q1 * m.n0) >>> 28
  let acc := acc + a.l0 * b.l2 + a.l1 * b.l1 + a.l2 * b.l0 + q0 * m.n2 + q1 * m.n1
  let q2 := ((acc &&& msk) * m.ninv) &&& msk
  let acc := (acc + q2 * m.n0) >>> 28
  let acc := acc + a.l0 * b.l3 + a.l1 * b.l2 + a.l2 * b.l1 + a.l3 * b.l0 + q0 * m.n3 + q1 * m.n2 + q2 * m.n1
  let q3 := ((acc &&& msk) * m.ninv) &&& msk
  let acc := (acc + q3 * m.n0) >>> 28
  let acc := acc + a.l1 * b.l3 + a.l2 * b.l2 + a.l3 * b.l1 + q1 * m.n3 + q2 * m.n2 + q3 * m.n1
  let u0 := acc &&& msk
  let acc := acc >>> 28
  let acc := acc + a.l2 * b.l3 + a.l3 * b.l2 + q2 * m.n3 + q3 * m.n2
  let u1 := acc &&& msk
  let acc := acc >>> 28
  let acc := acc + a.l3 * b.l3 + q3 * m.n3
  let u2 := acc &&& msk
  let acc := acc >>> 28
  let u3 := acc &&& msk
  let acc := acc >>> 28
  let t0 := u0 + 0x10000000 - m.n0
  let d0 := t0 &&& 0xFFFFFFF
  let b1 := (1 : UInt64) - (t0 >>> 28)
  let t1 := u1 + 0x10000000 - m.n1 - b1
  let d1 := t1 &&& 0xFFFFFFF
  let b2 := (1 : UInt64) - (t1 >>> 28)
  let t2 := u2 + 0x10000000 - m.n2 - b2
  let d2 := t2 &&& 0xFFFFFFF
  let b3 := (1 : UInt64) - (t2 >>> 28)
  let t3 := u3 + 0x10000000 - m.n3 - b3
  let d3 := t3 &&& 0xFFFFFFF
  let b4 := (1 : UInt64) - (t3 >>> 28)
  let s := (acc ||| ((1 : UInt64) - b4)) * 0xFFFFFFF
  ⟨u0 ^^^ ((u0 ^^^ d0) &&& s), u1 ^^^ ((u1 ^^^ d1) &&& s), u2 ^^^ ((u2 ^^^ d2) &&& s), u3 ^^^ ((u3 ^^^ d3) &&& s)⟩

/-- Montgomery square. -/
@[inline] def N4.sqr (m : Mod4) (a : N4) : N4 :=
  let msk : UInt64 := 0xFFFFFFF
  let acc : UInt64 := 0
  let acc := acc + a.l0 * a.l0
  let q0 := ((acc &&& msk) * m.ninv) &&& msk
  let acc := (acc + q0 * m.n0) >>> 28
  let acc := acc + ((a.l0 * a.l1) <<< 1) + q0 * m.n1
  let q1 := ((acc &&& msk) * m.ninv) &&& msk
  let acc := (acc + q1 * m.n0) >>> 28
  let acc := acc + ((a.l0 * a.l2) <<< 1) + a.l1 * a.l1 + q0 * m.n2 + q1 * m.n1
  let q2 := ((acc &&& msk) * m.ninv) &&& msk
  let acc := (acc + q2 * m.n0) >>> 28
  let acc := acc + ((a.l0 * a.l3) <<< 1) + ((a.l1 * a.l2) <<< 1) + q0 * m.n3 + q1 * m.n2 + q2 * m.n1
  let q3 := ((acc &&& msk) * m.ninv) &&& msk
  let acc := (acc + q3 * m.n0) >>> 28
  let acc := acc + ((a.l1 * a.l3) <<< 1) + a.l2 * a.l2 + q1 * m.n3 + q2 * m.n2 + q3 * m.n1
  let u0 := acc &&& msk
  let acc := acc >>> 28
  let acc := acc + ((a.l2 * a.l3) <<< 1) + q2 * m.n3 + q3 * m.n2
  let u1 := acc &&& msk
  let acc := acc >>> 28
  let acc := acc + a.l3 * a.l3 + q3 * m.n3
  let u2 := acc &&& msk
  let acc := acc >>> 28
  let u3 := acc &&& msk
  let acc := acc >>> 28
  let t0 := u0 + 0x10000000 - m.n0
  let d0 := t0 &&& 0xFFFFFFF
  let b1 := (1 : UInt64) - (t0 >>> 28)
  let t1 := u1 + 0x10000000 - m.n1 - b1
  let d1 := t1 &&& 0xFFFFFFF
  let b2 := (1 : UInt64) - (t1 >>> 28)
  let t2 := u2 + 0x10000000 - m.n2 - b2
  let d2 := t2 &&& 0xFFFFFFF
  let b3 := (1 : UInt64) - (t2 >>> 28)
  let t3 := u3 + 0x10000000 - m.n3 - b3
  let d3 := t3 &&& 0xFFFFFFF
  let b4 := (1 : UInt64) - (t3 >>> 28)
  let s := (acc ||| ((1 : UInt64) - b4)) * 0xFFFFFFF
  ⟨u0 ^^^ ((u0 ^^^ d0) &&& s), u1 ^^^ ((u1 ^^^ d1) &&& s), u2 ^^^ ((u2 ^^^ d2) &&& s), u3 ^^^ ((u3 ^^^ d3) &&& s)⟩

/-- `a + b mod n`. -/
@[inline] def N4.add (m : Mod4) (a b : N4) : N4 :=
  let msk : UInt64 := 0xFFFFFFF
  let x0 := a.l0 + b.l0
  let c1 := x0 >>> 28
  let v0 := x0 &&& msk
  let x1 := a.l1 + b.l1 + c1
  let c2 := x1 >>> 28
  let v1 := x1 &&& msk
  let x2 := a.l2 + b.l2 + c2
  let c3 := x2 >>> 28
  let v2 := x2 &&& msk
  let x3 := a.l3 + b.l3 + c3
  let c4 := x3 >>> 28
  let v3 := x3 &&& msk
  let t0 := v0 + 0x10000000 - m.n0
  let d0 := t0 &&& 0xFFFFFFF
  let b1 := (1 : UInt64) - (t0 >>> 28)
  let t1 := v1 + 0x10000000 - m.n1 - b1
  let d1 := t1 &&& 0xFFFFFFF
  let b2 := (1 : UInt64) - (t1 >>> 28)
  let t2 := v2 + 0x10000000 - m.n2 - b2
  let d2 := t2 &&& 0xFFFFFFF
  let b3 := (1 : UInt64) - (t2 >>> 28)
  let t3 := v3 + 0x10000000 - m.n3 - b3
  let d3 := t3 &&& 0xFFFFFFF
  let b4 := (1 : UInt64) - (t3 >>> 28)
  let s := (c4 ||| ((1 : UInt64) - b4)) * 0xFFFFFFF
  ⟨v0 ^^^ ((v0 ^^^ d0) &&& s), v1 ^^^ ((v1 ^^^ d1) &&& s), v2 ^^^ ((v2 ^^^ d2) &&& s), v3 ^^^ ((v3 ^^^ d3) &&& s)⟩

/-- `a - b mod n`. -/
@[inline] def N4.sub (m : Mod4) (a b : N4) : N4 :=
  let msk : UInt64 := 0xFFFFFFF
  let t0 := a.l0 + 0x10000000 - b.l0
  let d0 := t0 &&& msk
  let b1 := (1 : UInt64) - (t0 >>> 28)
  let t1 := a.l1 + 0x10000000 - b.l1 - b1
  let d1 := t1 &&& msk
  let b2 := (1 : UInt64) - (t1 >>> 28)
  let t2 := a.l2 + 0x10000000 - b.l2 - b2
  let d2 := t2 &&& msk
  let b3 := (1 : UInt64) - (t2 >>> 28)
  let t3 := a.l3 + 0x10000000 - b.l3 - b3
  let d3 := t3 &&& msk
  let b4 := (1 : UInt64) - (t3 >>> 28)
  let s := b4 * msk
  let y0 := d0 + (m.n0 &&& s)
  let e1 := y0 >>> 28
  let y1 := d1 + (m.n1 &&& s) + e1
  let e2 := y1 >>> 28
  let y2 := d2 + (m.n2 &&& s) + e2
  let e3 := y2 >>> 28
  let y3 := d3 + (m.n3 &&& s) + e3
  ⟨y0 &&& msk, y1 &&& msk, y2 &&& msk, y3 &&& msk⟩

set_option maxRecDepth 200000 in
/-- The ECM stage-1 Montgomery ladder over `bits[i-1], …, bits[0]` from
`(r0, r1) = ((a : b), (c : d))` (limbs) for the curve `a24` and the base point
`(xP : 1)`; returns `r0`. One step doubles `r0` (bit `0`) or `r1` (bit `1`) and
adds `r0 + r1`; the coordinates stay in machine words, so a step allocates
nothing. -/
def N4.ladderGo (m : Mod4) (a24 xP : N4) (bits : ByteArray) (i : Nat)
    (a0 a1 a2 a3 b0 b1 b2 b3 c0 c1 c2 c3 d0 d1 d2 d3 : UInt64) : N4 × N4 :=
  match i with
  | 0 => (⟨a0, a1, a2, a3⟩, ⟨b0, b1, b2, b3⟩)
  | i + 1 =>
    let sel := (if bits.get! i == 1 then (1 : UInt64) else 0) * 0xFFFFFFF
    let X0 : N4 := ⟨a0, a1, a2, a3⟩
    let Z0 : N4 := ⟨b0, b1, b2, b3⟩
    let X1 : N4 := ⟨c0, c1, c2, c3⟩
    let Z1 : N4 := ⟨d0, d1, d2, d3⟩
    let Ax : N4 := ⟨a0 ^^^ ((a0 ^^^ c0) &&& sel), a1 ^^^ ((a1 ^^^ c1) &&& sel), a2 ^^^ ((a2 ^^^ c2) &&& sel), a3 ^^^ ((a3 ^^^ c3) &&& sel)⟩
    let Az : N4 := ⟨b0 ^^^ ((b0 ^^^ d0) &&& sel), b1 ^^^ ((b1 ^^^ d1) &&& sel), b2 ^^^ ((b2 ^^^ d2) &&& sel), b3 ^^^ ((b3 ^^^ d3) &&& sel)⟩
    let s := N4.sqr m (N4.add m Ax Az)
    let e := N4.sqr m (N4.sub m Ax Az)
    let t := N4.sub m s e
    let Dx := N4.mul m s e
    let Dz := N4.mul m t (N4.add m e (N4.mul m a24 t))
    let u := N4.mul m (N4.sub m X1 Z1) (N4.add m X0 Z0)
    let v := N4.mul m (N4.add m X1 Z1) (N4.sub m X0 Z0)
    let Sx := N4.sqr m (N4.add m u v)
    let Sz := N4.mul m xP (N4.sqr m (N4.sub m u v))
    N4.ladderGo m a24 xP bits i
      (Dx.l0 ^^^ ((Dx.l0 ^^^ Sx.l0) &&& sel)) (Dx.l1 ^^^ ((Dx.l1 ^^^ Sx.l1) &&& sel)) (Dx.l2 ^^^ ((Dx.l2 ^^^ Sx.l2) &&& sel)) (Dx.l3 ^^^ ((Dx.l3 ^^^ Sx.l3) &&& sel))
      (Dz.l0 ^^^ ((Dz.l0 ^^^ Sz.l0) &&& sel)) (Dz.l1 ^^^ ((Dz.l1 ^^^ Sz.l1) &&& sel)) (Dz.l2 ^^^ ((Dz.l2 ^^^ Sz.l2) &&& sel)) (Dz.l3 ^^^ ((Dz.l3 ^^^ Sz.l3) &&& sel))
      (Sx.l0 ^^^ ((Sx.l0 ^^^ Dx.l0) &&& sel)) (Sx.l1 ^^^ ((Sx.l1 ^^^ Dx.l1) &&& sel)) (Sx.l2 ^^^ ((Sx.l2 ^^^ Dx.l2) &&& sel)) (Sx.l3 ^^^ ((Sx.l3 ^^^ Dx.l3) &&& sel))
      (Sz.l0 ^^^ ((Sz.l0 ^^^ Dz.l0) &&& sel)) (Sz.l1 ^^^ ((Sz.l1 ^^^ Dz.l1) &&& sel)) (Sz.l2 ^^^ ((Sz.l2 ^^^ Dz.l2) &&& sel)) (Sz.l3 ^^^ ((Sz.l3 ^^^ Dz.l3) &&& sel))

instance : Arith N4 Mod4 where
  mul := N4.mul
  sqr := N4.sqr
  add := N4.add
  sub := N4.sub
  modulus := Mod4.n
  ofLimbs _ x := N4.ofLimbs x
  limbNat := N4.limbNat
  isZero := N4.isZero
  limbs := 4
  ladder m a24 xP bits i X0 Z0 X1 Z1 := N4.ladderGo m a24 xP bits i
    X0.l0 X0.l1 X0.l2 X0.l3 Z0.l0 Z0.l1 Z0.l2 Z0.l3
    X1.l0 X1.l1 X1.l2 X1.l3 Z1.l0 Z1.l1 Z1.l2 Z1.l3

/-- A residue modulo a `Mod5` in Montgomery form: 5 limbs of 28 bits. -/
structure N5 where
  l0 : UInt64
  l1 : UInt64
  l2 : UInt64
  l3 : UInt64
  l4 : UInt64
  deriving Inhabited

/-- An odd modulus below `2^140` with its limbs and `-n⁻¹ mod 2^28`. -/
structure Mod5 where
  n : Nat
  n0 : UInt64
  n1 : UInt64
  n2 : UInt64
  n3 : UInt64
  n4 : UInt64
  ninv : UInt64

def Mod5.ofNat (n : Nat) : Mod5 :=
  ⟨n, (n >>> 0 &&& 0xFFFFFFF).toUInt64, (n >>> 28 &&& 0xFFFFFFF).toUInt64, (n >>> 56 &&& 0xFFFFFFF).toUInt64, (n >>> 84 &&& 0xFFFFFFF).toUInt64, (n >>> 112 &&& 0xFFFFFFF).toUInt64, negInv28 (n &&& 0xFFFFFFF).toUInt64⟩

@[inline] def N5.ofLimbs (x : Nat) : N5 :=
  ⟨(x >>> 0 &&& 0xFFFFFFF).toUInt64, (x >>> 28 &&& 0xFFFFFFF).toUInt64, (x >>> 56 &&& 0xFFFFFFF).toUInt64, (x >>> 84 &&& 0xFFFFFFF).toUInt64, (x >>> 112 &&& 0xFFFFFFF).toUInt64⟩

@[inline] def N5.limbNat (a : N5) : Nat :=
  (a.l0.toNat <<< 0) ||| (a.l1.toNat <<< 28) ||| (a.l2.toNat <<< 56) ||| (a.l3.toNat <<< 84) ||| (a.l4.toNat <<< 112)

@[inline] def N5.isZero (a : N5) : Bool :=
  (a.l0 ||| a.l1 ||| a.l2 ||| a.l3 ||| a.l4) == 0

/-- Montgomery product `a b R⁻¹ mod n` (`R = 2^140`), inputs and output in `[0, n)`. -/
@[inline] def N5.mul (m : Mod5) (a b : N5) : N5 :=
  let msk : UInt64 := 0xFFFFFFF
  let acc : UInt64 := 0
  let acc := acc + a.l0 * b.l0
  let q0 := ((acc &&& msk) * m.ninv) &&& msk
  let acc := (acc + q0 * m.n0) >>> 28
  let acc := acc + a.l0 * b.l1 + a.l1 * b.l0 + q0 * m.n1
  let q1 := ((acc &&& msk) * m.ninv) &&& msk
  let acc := (acc + q1 * m.n0) >>> 28
  let acc := acc + a.l0 * b.l2 + a.l1 * b.l1 + a.l2 * b.l0 + q0 * m.n2 + q1 * m.n1
  let q2 := ((acc &&& msk) * m.ninv) &&& msk
  let acc := (acc + q2 * m.n0) >>> 28
  let acc := acc + a.l0 * b.l3 + a.l1 * b.l2 + a.l2 * b.l1 + a.l3 * b.l0 + q0 * m.n3 + q1 * m.n2 + q2 * m.n1
  let q3 := ((acc &&& msk) * m.ninv) &&& msk
  let acc := (acc + q3 * m.n0) >>> 28
  let acc := acc + a.l0 * b.l4 + a.l1 * b.l3 + a.l2 * b.l2 + a.l3 * b.l1 + a.l4 * b.l0 + q0 * m.n4 + q1 * m.n3 + q2 * m.n2 + q3 * m.n1
  let q4 := ((acc &&& msk) * m.ninv) &&& msk
  let acc := (acc + q4 * m.n0) >>> 28
  let acc := acc + a.l1 * b.l4 + a.l2 * b.l3 + a.l3 * b.l2 + a.l4 * b.l1 + q1 * m.n4 + q2 * m.n3 + q3 * m.n2 + q4 * m.n1
  let u0 := acc &&& msk
  let acc := acc >>> 28
  let acc := acc + a.l2 * b.l4 + a.l3 * b.l3 + a.l4 * b.l2 + q2 * m.n4 + q3 * m.n3 + q4 * m.n2
  let u1 := acc &&& msk
  let acc := acc >>> 28
  let acc := acc + a.l3 * b.l4 + a.l4 * b.l3 + q3 * m.n4 + q4 * m.n3
  let u2 := acc &&& msk
  let acc := acc >>> 28
  let acc := acc + a.l4 * b.l4 + q4 * m.n4
  let u3 := acc &&& msk
  let acc := acc >>> 28
  let u4 := acc &&& msk
  let acc := acc >>> 28
  let t0 := u0 + 0x10000000 - m.n0
  let d0 := t0 &&& 0xFFFFFFF
  let b1 := (1 : UInt64) - (t0 >>> 28)
  let t1 := u1 + 0x10000000 - m.n1 - b1
  let d1 := t1 &&& 0xFFFFFFF
  let b2 := (1 : UInt64) - (t1 >>> 28)
  let t2 := u2 + 0x10000000 - m.n2 - b2
  let d2 := t2 &&& 0xFFFFFFF
  let b3 := (1 : UInt64) - (t2 >>> 28)
  let t3 := u3 + 0x10000000 - m.n3 - b3
  let d3 := t3 &&& 0xFFFFFFF
  let b4 := (1 : UInt64) - (t3 >>> 28)
  let t4 := u4 + 0x10000000 - m.n4 - b4
  let d4 := t4 &&& 0xFFFFFFF
  let b5 := (1 : UInt64) - (t4 >>> 28)
  let s := (acc ||| ((1 : UInt64) - b5)) * 0xFFFFFFF
  ⟨u0 ^^^ ((u0 ^^^ d0) &&& s), u1 ^^^ ((u1 ^^^ d1) &&& s), u2 ^^^ ((u2 ^^^ d2) &&& s), u3 ^^^ ((u3 ^^^ d3) &&& s), u4 ^^^ ((u4 ^^^ d4) &&& s)⟩

/-- Montgomery square. -/
@[inline] def N5.sqr (m : Mod5) (a : N5) : N5 :=
  let msk : UInt64 := 0xFFFFFFF
  let acc : UInt64 := 0
  let acc := acc + a.l0 * a.l0
  let q0 := ((acc &&& msk) * m.ninv) &&& msk
  let acc := (acc + q0 * m.n0) >>> 28
  let acc := acc + ((a.l0 * a.l1) <<< 1) + q0 * m.n1
  let q1 := ((acc &&& msk) * m.ninv) &&& msk
  let acc := (acc + q1 * m.n0) >>> 28
  let acc := acc + ((a.l0 * a.l2) <<< 1) + a.l1 * a.l1 + q0 * m.n2 + q1 * m.n1
  let q2 := ((acc &&& msk) * m.ninv) &&& msk
  let acc := (acc + q2 * m.n0) >>> 28
  let acc := acc + ((a.l0 * a.l3) <<< 1) + ((a.l1 * a.l2) <<< 1) + q0 * m.n3 + q1 * m.n2 + q2 * m.n1
  let q3 := ((acc &&& msk) * m.ninv) &&& msk
  let acc := (acc + q3 * m.n0) >>> 28
  let acc := acc + ((a.l0 * a.l4) <<< 1) + ((a.l1 * a.l3) <<< 1) + a.l2 * a.l2 + q0 * m.n4 + q1 * m.n3 + q2 * m.n2 + q3 * m.n1
  let q4 := ((acc &&& msk) * m.ninv) &&& msk
